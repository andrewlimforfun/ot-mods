<Project>
    <PropertyGroup>
        <!--
      Shared build properties for the on-together-mods monorepo.
      Version here is Alpha's version. Each mod project overrides Version in its own csproj.
      AlphaVersion is captured from Version at props evaluation time (before csproj overrides).
    -->
        <Authors>AndrewLin</Authors>
        <TeamName>AndrewLin</TeamName>
        <!-- Alpha library version — bump when publishing a new Alpha NuGet -->
        <Version>0.0.1</Version>
        <RepositoryUrl>https://github.com/andrewlimforfun/on-together-mods</RepositoryUrl>
        <Website>$(RepositoryUrl)</Website>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Nullable>enable</Nullable>

        <!-- Version of the BepInEx dependency declared in thunderstore manifests -->
        <ThunderstoreBepInExVersion>5.4.2305</ThunderstoreBepInExVersion>
        <!-- Version of the Alpha NuGet consumed by the mods -->
        <AlphaVersion>$(Version)</AlphaVersion>

        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Configurations>Debug;Release;Install;Publish</Configurations>

        <!-- NuGet sources: official + BepInEx + samboy + local -->
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json;
            $(MSBuildThisFileDirectory)..\nuget-local\
        </RestoreAdditionalProjectSources>

        <!-- r2modman local install path — override per-machine via Directory.Build.user -->
        <LocalBepInExPluginPath>$(APPDATA)\r2modmanPlus-local\OnTogetherVirtualCoWorking\profiles\Default\BepInEx\plugins\</LocalBepInExPluginPath>
    </PropertyGroup>
</Project>
