<Project>
    <PropertyGroup>
        <!--
      Shared build properties for the on-together-mods monorepo.
      Version here is Alpha's version. Each mod project overrides Version in its own csproj.
      AlphaVersion is captured from Version at props evaluation time (before csproj overrides).
    -->
        <Authors>AndrewLin</Authors>
        <TeamName>AndrewLin</TeamName>
        <RepositoryUrl>https://github.com/andrewlimforfun/ot-mods</RepositoryUrl>
        <Website>$(RepositoryUrl)</Website>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Nullable>enable</Nullable>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Configurations>Debug;Install;Publish</Configurations>

        <!-- External dependency versions — update here to sync all thunderstore.toml files -->
        <BepInExVersion>5.4.2305</BepInExVersion>

        <!-- Mods Versions -->
        <AlphaVersion>0.0.5-SNAPSHOT</AlphaVersion>
        <ChalkyVersion>1.2.1-SNAPSHOT</ChalkyVersion>
        <DndVersion>1.0.1-SNAPSHOT</DndVersion>
        <FomoVersion>1.2.1-SNAPSHOT</FomoVersion>
        <RemindVersion>1.1.6-SNAPSHOT</RemindVersion>
        <HushVersion>0.0.5-SNAPSHOT</HushVersion>
        <EchoVersion>0.0.1-SNAPSHOT</EchoVersion>

        <!-- NuGet sources: official + BepInEx + samboy + local -->
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json;
        </RestoreAdditionalProjectSources>

        <!-- r2modman local install path — override per-machine via Directory.Build.user -->
        <LocalBepInExPluginPath>$(APPDATA)\r2modmanPlus-local\OnTogetherVirtualCoWorking\profiles\Default\BepInEx\plugins\</LocalBepInExPluginPath>
    </PropertyGroup>
</Project>
