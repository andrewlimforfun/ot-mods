<Project>
    <PropertyGroup>
        <!--
      Shared build properties for the on-together-mods monorepo.
      Version here is Alpha's version. Each mod project overrides Version in its own csproj.
      AlphaVersion is captured from Version at props evaluation time (before csproj overrides).
    -->
        <Authors>AndrewLin</Authors>
        <TeamName>AndrewLin</TeamName>
        <RepositoryUrl>https://github.com/andrewlimforfun/ot-mods</RepositoryUrl>
        <Website>$(RepositoryUrl)</Website>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <TargetFramework>netstandard2.1</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Nullable>enable</Nullable>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Configurations>Debug;Install;Publish</Configurations>

        <!-- External dependency versions — update here to sync all thunderstore.toml files -->
        <BepInExVersion>5.4.2305</BepInExVersion>
        <OnTogetherGameLibsVersion>2.0.0</OnTogetherGameLibsVersion>

        <!-- Set to true to use local game DLLs instead of the OnTogether.GameLibs NuGet package -->
        <UseLocalGameLibs>true</UseLocalGameLibs>
        <GameManagedPath>C:\Program Files (x86)\Steam\steamapps\common\On-Together\On-Together\OnTogether_Data\Managed</GameManagedPath>

        <!-- Mods Versions -->
        <AlphaVersion>0.1.0</AlphaVersion>
        <ChalkyVersion>1.2.8</ChalkyVersion>
        <DndVersion>1.0.5</DndVersion>
        <EchoVersion>0.1.9</EchoVersion>
        <FomoVersion>1.2.9</FomoVersion>
        <HushVersion>0.1.13</HushVersion>
        <ReconnectVersion>0.0.2</ReconnectVersion>
        <RemindVersion>1.1.10</RemindVersion>
        <SweepVersion>0.0.1</SweepVersion>
        <JaideAdapterVersion>0.0.1</JaideAdapterVersion>

        <!-- NuGet sources: official + BepInEx + samboy + local -->
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json;
        </RestoreAdditionalProjectSources>

        <!-- r2modman local install path — override per-machine via Directory.Build.user -->
        <LocalBepInExPluginPath>$(APPDATA)\r2modmanPlus-local\OnTogetherVirtualCoWorking\profiles\Default\BepInEx\plugins\</LocalBepInExPluginPath>
    </PropertyGroup>
</Project>
