<!DOCTYPE Project>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>$(FomoVersion)</Version>
        <AssemblyName>AndrewLin.FomoChatLog</AssemblyName>
        <PackageName>FomoChatLog</PackageName>
        <RootNamespace>FomoChatLog</RootNamespace>
        <Description>FomoChatLog: A Fomo submod that logs On-Together chat messages to a local text file. Use /fomohelp and look for /fomochatlog commands</Description>
        <LocalInstallPath>$(LocalBepInExPluginPath)\$(TeamName)-$(PackageName)Dev\</LocalInstallPath>
    </PropertyGroup>

    <!-- NuGet Packages -->
    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
        <PackageReference Include="OnTogether.GameLibs" Version="1.1.0" />
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.61" IncludeAssets="compile" />
        <PackageReference Include="HarmonyX" Version="2.10.1" />
    </ItemGroup>

    <!-- Reference the core Fomo mod so we can use IChatSink, ChatEntry, etc. -->
    <ItemGroup>
        <ProjectReference Include="..\Fomo\Fomo.csproj" />
    </ItemGroup>

    <!-- Generate BuildInfo.g.cs -->
    <Target Name="GenerateVersionFile" BeforeTargets="BeforeBuild">
        <PropertyGroup>
            <VersionFileContent>
                namespace $(RootNamespace) {
                public static class BuildInfo {
                public const string Version = "$(Version)"%3b
                }
                }
            </VersionFileContent>
        </PropertyGroup>
        <WriteLinesToFile File="BuildInfo.g.cs" Lines="$(VersionFileContent)" Overwrite="true" />
    </Target>

    <!-- Install target -->
    <Target Name="Install" AfterTargets="Build" Condition="'$(Configuration)' == 'Install'">
        <Message Importance="high" Text="Copying [$(TargetFileName)] to: $(LocalInstallPath)" />
        <Error Condition="'$(LocalBepInExPluginPath)' == ''" Text="LocalBepInExPluginPath is empty! Check your PropertyGroup." />
        <MakeDir Directories="$(LocalInstallPath)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalInstallPath)" />
        <!-- <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(LocalInstallPath)" SkipUnchangedFiles="true" /> -->
    </Target>

    <Target Name="CleanInstall" AfterTargets="Clean" Condition="'$(Configuration)' == 'Install'">
        <Message Importance="high" Text="Deleting [$(TargetFileName)] from: $(LocalInstallPath)" />
        <RemoveDir Directories="$(LocalInstallPath)" />
    </Target>

    <!--
      Publish to Thunderstore: dotnet build -c Publish
      Requires tcli (https://github.com/thunderstore-io/thunderstore-cli):
        dotnet tool install -g tcli
      Requires TCLI_AUTH_TOKEN env var
    -->
    <Target Name="ThunderstorePublish" AfterTargets="Build" Condition="'$(Configuration)' == 'Publish'">
        <Message Importance="high" Text="Publishing $(PackageName) v$(Version) to Thunderstore..." />
        <Exec WorkingDirectory="$(ProjectDir)"
              Command="tcli publish --package-version $(Version)" />
    </Target>


</Project>
