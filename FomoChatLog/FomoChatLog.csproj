<!DOCTYPE Project>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>$(FomoVersion)</Version>
        <AssemblyName>AndrewLin.FomoChatLog</AssemblyName>
        <PackageName>FomoChatLog</PackageName>
        <RootNamespace>FomoChatLog</RootNamespace>
        <Description>FomoChatLog: A Fomo submod that logs On-Together chat messages to a local text file. Use /fomohelp and look for /fomochatlog commands</Description>
        <LocalInstallPath>$(LocalBepInExPluginPath)\$(TeamName)-$(PackageName)Dev\</LocalInstallPath>
    </PropertyGroup>

    <!-- NuGet Packages -->
    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
        <PackageReference Include="OnTogether.GameLibs" Version="$(OnTogetherGameLibsVersion)" />
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.61" IncludeAssets="compile" />
        <PackageReference Include="HarmonyX" Version="2.10.1" />
    </ItemGroup>

    <!-- Reference the core Fomo mod so we can use IChatSink, ChatEntry, etc. -->
    <ItemGroup>
        <ProjectReference Include="..\Fomo\Fomo.csproj"  SetConfiguration="Configuration=Debug"/>
    </ItemGroup>


</Project>
