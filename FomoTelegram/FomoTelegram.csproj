<!DOCTYPE Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(FomoVersion)</Version>
    <AssemblyName>AndrewLin.FomoTelegram</AssemblyName>
    <PackageName>FomoTelegram</PackageName>
    <RootNamespace>FomoTelegram</RootNamespace>
    <Description>FomoTelegram: A Fomo submod that relays On-Together chat messages to a Telegram chat via a Telegram Bot.  Use /fomohelp and look for /fomotelegram commands</Description>
    <LocalInstallPath>$(LocalBepInExPluginPath)\$(TeamName)-$(PackageName)Dev\</LocalInstallPath>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="OnTogether.GameLibs" Version="$(OnTogetherGameLibsVersion)" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.61" IncludeAssets="compile" />
    <PackageReference Include="HarmonyX" Version="2.10.1" />
    <!-- Use Newtonsoft.Json (shipped by BepInEx) for Telegram HTTP API calls.
         ExcludeAssets="runtime" avoids shipping a second copy alongside BepInEx's own dll. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Reference the core Fomo mod so we can use IChatSink, ChatEntry, etc. -->
  <ItemGroup>
    <ProjectReference Include="..\Fomo\Fomo.csproj" SetConfiguration="Configuration=Debug"/>
  </ItemGroup>


</Project>
