<!DOCTYPE Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(FomoVersion)</Version>
    <AssemblyName>AndrewLin.FomoWebSocket</AssemblyName>
    <PackageName>FomoWebSocket</PackageName>
    <RootNamespace>FomoWebSocket</RootNamespace>
    <Description>FomoWebSocket: WebSocket relay add-on for the Fomo mod. Use /fomohelp and look for /fomowebsocket commands</Description>
    <LocalInstallPath>$(LocalBepInExPluginPath)\$(TeamName)-$(PackageName)Dev\</LocalInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="OnTogether.GameLibs" Version="1.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.61" IncludeAssets="compile" />
    <PackageReference Include="HarmonyX" Version="2.10.1" />
    <PackageReference Include="Fleck" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference main Fomo mod for its public API (ChatSinkManager, CommandManager, etc.) -->
    <ProjectReference Include="..\Fomo\Fomo.csproj" />
  </ItemGroup>

  <!-- FomoWebSocket ships Fleck.dll — copy it alongside the main assembly when installing locally -->
  <Target Name="InstallFleck" AfterTargets="Install" Condition="'$(Configuration)' == 'Install'">
    <Copy SourceFiles="$(TargetDir)Fleck.dll" DestinationFolder="$(LocalInstallPath)" />
  </Target>

</Project>
